<mxfile host="Electron">
  <diagram id="long-horizon" name="Long-Horizon Execution">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" background="#f5f5f5" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Long-Horizon Autonomous Execution&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #888&quot;&gt;Sustained work across multiple context windows&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="50" as="geometry" />
        </mxCell>
        <!-- Three pillars -->
        <mxCell id="pillar1" value="&lt;b style=&quot;font-size:15px&quot;&gt;① Filesystem + Git&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#666&quot;&gt;&lt;b&gt;Tracking Work Across Sessions&lt;/b&gt;&lt;br&gt;• Read data, code, docs&lt;br&gt;• Incremental work offload&lt;br&gt;• Collaboration surface&lt;br&gt;• Version control + rollback&lt;br&gt;• Branch experiments&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;arcSize=8;shadow=1;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="pillar2" value="&lt;b style=&quot;font-size:15px&quot;&gt;② Ralph Loops&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#666&quot;&gt;&lt;b&gt;Continuing Work Without Losing Context&lt;/b&gt;&lt;br&gt;• Intercept model exit attempt&lt;br&gt;• Reinject original prompt&lt;br&gt;• Clean context window&lt;br&gt;• Maintain state via filesystem&lt;br&gt;• Loop until task complete&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=8;shadow=1;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="pillar3" value="&lt;b style=&quot;font-size:15px&quot;&gt;③ Planning + Self-Verification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#666&quot;&gt;&lt;b&gt;Staying on Track&lt;/b&gt;&lt;br&gt;• Decompose goals into steps&lt;br&gt;• Check correctness via tests&lt;br&gt;• Validate output quality&lt;br&gt;• Self-diagnose failures&lt;br&gt;• Retry with adjustments&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;shadow=1;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="100" width="280" height="160" as="geometry" />
        </mxCell>
        <!-- Arrows connecting pillars -->
        <mxCell id="arr1" value="&lt;font style=&quot;font-size:10px&quot;&gt;state tracking&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999;strokeWidth=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="180" as="sourcePoint" />
            <mxPoint x="420" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arr2" value="&lt;font style=&quot;font-size:10px&quot;&gt;clean context&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999;strokeWidth=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="180" as="sourcePoint" />
            <mxPoint x="760" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Ralph Loop detailed flow -->
        <mxCell id="ralph-title" value="&lt;b&gt;Ralph Loop Flow&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px; color: #888&quot;&gt;How the loop sustains long-horizon work&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="500" y="300" width="300" height="40" as="geometry" />
        </mxCell>
        <!-- Step 1 -->
        <mxCell id="step1" value="&lt;b&gt;Step 1&lt;/b&gt;&lt;br&gt;Agent receives task&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#888&quot;&gt;Initial context window&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="370" width="180" height="70" as="geometry" />
        </mxCell>
        <!-- Arrow 1-2 -->
        <mxCell id="arrow1" value="&lt;font style=&quot;font-size:10px&quot;&gt;work&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="260" y="405" as="sourcePoint" />
            <mxPoint x="320" y="405" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Step 2 -->
        <mxCell id="step2" value="&lt;b&gt;Step 2&lt;/b&gt;&lt;br&gt;Context window fills up&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#888&quot;&gt;Context rot risk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="320" y="370" width="180" height="70" as="geometry" />
        </mxCell>
        <!-- Arrow 2-3 -->
        <mxCell id="arrow2" value="&lt;font style=&quot;font-size:10px&quot;&gt;detect&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="405" as="sourcePoint" />
            <mxPoint x="560" y="405" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Step 3 -->
        <mxCell id="step3" value="&lt;b&gt;Step 3&lt;/b&gt;&lt;br&gt;Save state to filesystem&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#888&quot;&gt;Git commit progress&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="370" width="180" height="70" as="geometry" />
        </mxCell>
        <!-- Arrow 3-4 -->
        <mxCell id="arrow3" value="&lt;font style=&quot;font-size:10px&quot;&gt;reset&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="405" as="sourcePoint" />
            <mxPoint x="800" y="405" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Step 4 -->
        <mxCell id="step4" value="&lt;b&gt;Step 4&lt;/b&gt;&lt;br&gt;Clean context window&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#888&quot;&gt;Fresh start, full capacity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="800" y="370" width="180" height="70" as="geometry" />
        </mxCell>
        <!-- Arrow 4-1 (loop back) -->
        <mxCell id="arrow-loop" value="&lt;font style=&quot;font-size:10px&quot;&gt;reinject prompt&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="440" as="sourcePoint" />
            <mxPoint x="890" y="500" as="targetPoint" />
            <mxPoint x="170" y="500" as="targetPoint" />
            <mxPoint x="170" y="440" as="targetPoint" />
            <Array as="points">
              <mxPoint x="890" y="520" />
              <mxPoint x="170" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- Loop label -->
        <mxCell id="loop-label" value="&lt;b&gt;🔄 LOOP&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="480" y="500" width="100" height="30" as="geometry" />
        </mxCell>
        <!-- Arrow back to step 1 -->
        <mxCell id="arrow-back" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="440" as="sourcePoint" />
            <mxPoint x="170" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Key insight -->
        <mxCell id="insight" value="&lt;b style=&quot;font-size:14px&quot;&gt;💡 Key Insight&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#666&quot;&gt;Long-horizon work requires &lt;b&gt;durable state, planning, observation, and verification&lt;/b&gt; to keep working across multiple context windows.&lt;br&gt;The Ralph Loop pattern turns a single-session model into a multi-session autonomous agent.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffacd;strokeColor=#d6b656;strokeWidth=2;arcSize=8;shadow=1;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="570" width="800" height="70" as="geometry" />
        </mxCell>
        <!-- Footer -->
        <mxCell id="footer" value="Source: LangChain Blog — The Anatomy of an Agent Harness (Vivek Trivedy, March 2026)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="670" width="500" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
