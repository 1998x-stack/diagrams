<mxfile host="Electron">
  <diagram id="future-harness" name="Future of Harness Engineering">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#f5f5f5" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;The Future of Harness Engineering&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #888&quot;&gt;Where we're headed and what's next&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="50" as="geometry" />
        </mxCell>
        <!-- Current State -->
        <mxCell id="current-title" value="&lt;b&gt;Today&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#888&quot;&gt;Post-training with models + harnesses in the loop&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="200" height="40" as="geometry" />
        </mxCell>
        <!-- Today's state -->
        <mxCell id="today1" value="🔄 Feedback Loop&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Discover → Add to Harness → Train&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="today2" value="🏗️ Fixed Harness&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Static set of tools &amp; prompts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="today3" value="🔧 Manual Tuning&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Human engineers craft prompts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="240" height="60" as="geometry" />
        </mxCell>
        <!-- Arrow to Future -->
        <mxCell id="arrow" value="&lt;font style=&quot;font-size:14px;font-weight:bold;color:#82b366&quot;&gt;Evolution →&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="350" y="230" width="100" height="30" as="geometry" />
        </mxCell>
        <!-- Future State -->
        <mxCell id="future-title" value="&lt;b&gt;Future&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#888&quot;&gt;Dynamic, self-improving harnesses&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="200" height="40" as="geometry" />
        </mxCell>
        <!-- Future state -->
        <mxCell id="future1" value="🔄 Self-Improving&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Agents analyze own traces&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="160" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="future2" value="⚡ JIT Assembly&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Dynamic tool &amp; context loading&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="240" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="future3" value="🤖 Autonomous Scaling&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;100s of agents on shared codebase&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="320" width="240" height="60" as="geometry" />
        </mxCell>
        <!-- Arrows from today to future -->
        <mxCell id="arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="190" as="sourcePoint" />
            <mxPoint x="500" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arr2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="270" as="sourcePoint" />
            <mxPoint x="500" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arr3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="350" as="sourcePoint" />
            <mxPoint x="500" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Key insight -->
        <mxCell id="insight" value="&lt;b style=&quot;font-size:16px&quot;&gt;⚡ Key Discovery&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#333&quot;&gt;By &lt;b&gt;only changing the harness&lt;/b&gt;, a coding agent went from &lt;b&gt;Top 30 → Top 5&lt;/b&gt; on Terminal Bench 2.0.&lt;br&gt;The best harness is NOT necessarily the one the model was post-trained with.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffacd;strokeColor=#d6b656;strokeWidth=2;arcSize=8;shadow=1;spacingTop=10;spacingLeft=10;spacingRight=10;spacingBottom=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="420" width="640" height="90" as="geometry" />
        </mxCell>
        <!-- Evolution timeline -->
        <mxCell id="timeline-title" value="&lt;b&gt;Harness Evolution Timeline&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="500" y="540" width="300" height="30" as="geometry" />
        </mxCell>
        <!-- Timeline phases -->
        <mxCell id="phase1" value="&lt;b&gt;Phase 1: Raw Models&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Text in → Text out&lt;br&gt;No tools, no state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="600" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="phase2" value="&lt;b&gt;Phase 2: Basic Harness&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;System prompts + tools&lt;br&gt;Chat interface, bash&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="350" y="600" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="phase3" value="&lt;b&gt;Phase 3: Post-Training&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Model + harness co-designed&lt;br&gt;Claude Code, Codex&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="600" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="phase4" value="&lt;b&gt;Phase 4: Dynamic Harness&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Self-improving, JIT assembly&lt;br&gt;100s of parallel agents&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="850" y="600" width="220" height="80" as="geometry" />
        </mxCell>
        <!-- Timeline arrows -->
        <mxCell id="t-arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1">
