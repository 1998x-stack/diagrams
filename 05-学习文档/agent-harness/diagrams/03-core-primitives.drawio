<mxfile host="Electron">
  <diagram id="core-primitives" name="6 Core Primitives">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#f5f5f5" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;6 Core Primitives of Harness Engineering&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #888&quot;&gt;What every agent needs to be effective&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="50" as="geometry" />
        </mxCell>
        <!-- Row 1 -->
        <!-- 1. Filesystem -->
        <mxCell id="p1" value="&lt;b style=&quot;font-size:15px&quot;&gt;① Filesystem&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666&quot;&gt;&lt;b&gt;Most foundational primitive&lt;/b&gt;&lt;br&gt;• Workspace for reading/writing&lt;br&gt;• Incremental offloading&lt;br&gt;• Multi-agent collaboration&lt;br&gt;• Git versioning + rollback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;arcSize=8;shadow=1;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="260" height="130" as="geometry" />
        </mxCell>
        <!-- 2. Bash + Code -->
        <mxCell id="p2" value="&lt;b style=&quot;font-size:15px&quot;&gt;② Bash + Code Exec&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666&quot;&gt;&lt;b&gt;General-purpose tool&lt;/b&gt;&lt;br&gt;• Autonomous problem solving&lt;br&gt;• Write &amp; execute code&lt;br&gt;• &quot;Give model a computer&quot;&lt;br&gt;• Let it figure out the rest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=8;shadow=1;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="260" height="130" as="geometry" />
        </mxCell>
        <!-- 3. Sandboxes -->
        <mxCell id="p3" value="&lt;b style=&quot;font-size:15px&quot;&gt;③ Sandboxes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666&quot;&gt;&lt;b&gt;Safe operating environments&lt;/b&gt;&lt;br&gt;• Isolated execution&lt;br&gt;• Install dependencies safely&lt;br&gt;• Browser, logs, screenshots&lt;br&gt;• Test runners for verification&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;shadow=1;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="100" width="260" height="130" as="geometry" />
        </mxCell>
        <!-- 4. Memory &amp; Search -->
        <mxCell id="p4" value="&lt;b style=&quot;font-size:15px&quot;&gt;④ Memory &amp; Search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666&quot;&gt;&lt;b&gt;Continual learning&lt;/b&gt;&lt;br&gt;• AGENTS.md injection&lt;br&gt;• Cross-session persistence&lt;br&gt;• Knowledge accumulation&lt;br&gt;• Search for recall&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;arcSize=8;shadow=1;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="260" height="130" as="geometry" />
        </mxCell>
        <!-- Row 2 -->
        <!-- 5. Context Rot -->
        <mxCell id="p5" value="&lt;b style=&quot;font-size:15px&quot;&gt;⑤ Battling Context Rot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666&quot;&gt;&lt;b&gt;Context window management&lt;/b&gt;&lt;br&gt;• Compaction when near limit&lt;br&gt;• Tool call offloading&lt;br&gt;• Skills for selective loading&lt;br&gt;• Reduce context pollution&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;arcSize=8;shadow=1;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="260" width="260" height="130" as="geometry" />
        </mxCell>
        <!-- 6. Long Horizon -->
        <mxCell id="p6" value="&lt;b style=&quot;font-size:15px&quot;&gt;⑥ Long-Horizon Execution&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666&quot;&gt;&lt;b&gt;Sustained autonomous work&lt;/b&gt;&lt;br&gt;• Ralph Loops for continuation&lt;br&gt;• Planning + self-verification&lt;br&gt;• Goal decomposition&lt;br&gt;• Test-driven correctness&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;arcSize=8;shadow=1;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="260" width="260" height="130" as="geometry" />
        </mxCell>
        <!-- Arrows between primitives -->
        <mxCell id="arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999;strokeWidth=1;dashed=1;endArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="165" as="sourcePoint" />
            <mxPoint x="340" y="165" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arr2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999;strokeWidth=1;dashed=1;endArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="165" as="sourcePoint" />
            <mxPoint x="620" y="165" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arr3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999;strokeWidth=1;dashed=1;endArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880" y="165" as="sourcePoint" />
            <mxPoint x="900" y="165" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Vertical arrows down -->
        <mxCell id="varr1" value="&lt;font style=&quot;font-size:10px&quot;&gt;enables&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999;strokeWidth=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="230" as="sourcePoint" />
            <mxPoint x="470" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="varr2" value="&lt;font style=&quot;font-size:10px&quot;&gt;enables&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999;strokeWidth=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="230" as="sourcePoint" />
            <mxPoint x="750" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Open Problems section -->
        <mxCell id="open-title" value="&lt;b&gt;Open Problems Being Explored&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="500" y="440" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="op1" value="&lt;b&gt;🔍 Problem 1&lt;/b&gt;&lt;br&gt;Orchestrating hundreds of agents&lt;br&gt;in parallel on a shared codebase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="500" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="op2" value="&lt;b&gt;🔍 Problem 2&lt;/b&gt;&lt;br&gt;Agents that analyze their own traces&lt;br&gt;to fix harness-level failures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="500" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="op3" value="&lt;b&gt;🔍 Problem 3&lt;/b&gt;&lt;br&gt;Just-in-time dynamic assembly&lt;br&gt;of tools and context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="800" y="500" width="300" height="80" as="geometry" />
        </mxCell>
        <!-- Arrow from primitives to open problems -->
        <mxCell id="arr-op" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="390" as="sourcePoint" />
            <mxPoint x="750" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Key insight box -->
        <mxCell id="insight" value="&lt;b style=&quot;font-size:14px&quot;&gt;💡 The Coupling of Training &amp; Harness Design&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#666&quot;&gt;Agent products (Claude Code, Codex) are &lt;b&gt;post-trained&lt;/b&gt; with models and harnesses in the loop.&lt;br&gt;Useful primitives discovered → added to harness → used for next-gen model training.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffacd;strokeColor=#d6b656;strokeWidth=2;arcSize=8;shadow=1;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="620" width="800" height="70" as="geometry" />
        </mxCell>
        <!-- Insight 2 -->
        <mxCell id="insight2" value="&lt;b style=&quot;font-size:14px&quot;&gt;⚡ Best Harness ≠ Training Harness&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#666&quot;&gt;On Terminal Bench 2.0, Opus 4.6 in Claude Code scored far below Opus 4.6 in other harnesses.&lt;br&gt;By &lt;b&gt;only changing the harness&lt;/b&gt;, a coding agent went from Top 30 → Top 5.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;arcSize=8;shadow=1;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="720" width="800" height="70" as="geometry" />
        </mxCell>
        <!-- Footer -->
        <mxCell id="footer" value="Source: LangChain Blog — The Anatomy of an Agent Harness (Vivek Trivedy, March 2026)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="820" width="500" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
