        <mxCell id="center" value="&lt;div style=&quot;font-size:14px;font-weight:bold;color:#333&quot;&gt;HARNESS&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#666&quot;&gt;5 Component Types&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=50;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="490" y="170" width="140" height="60" as="geometry" />
        </mxCell>
        <!-- Key insight box -->
        <mxCell id="insight" value="&lt;div style=&quot;font-size:14px;font-weight:bold;color:#b85450&quot;&gt;💡 Key Insight&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#333;margin-top:4px&quot;&gt;The model contains the intelligence,&lt;br/&gt;but the harness makes it useful.&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#666;margin-top:6px;font-style:italic&quot;&gt;&quot;If you're not the model, you're the harness.&quot;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffacd;strokeColor=#d6b656;arcSize=8;shadow=1;spacingTop=10;spacingLeft=10;spacingRight=10;spacingBottom=10;" parent="1" vertex="1">
          <mxGeometry x="300" y="400" width="500" height="110" as="geometry" />
        </mxCell>
        <!-- Model capabilities vs Harness capabilities -->
        <mxCell id="model-cap-title" value="&lt;font style=&quot;font-size:16px;font-weight:bold;color:#b85450&quot;&gt;Model Alone (Raw)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="80" y="560" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="model-cap" value="&lt;div style=&quot;font-size:12px&quot;&gt;❌ No durable state&lt;br/&gt;❌ Cannot execute code&lt;br/&gt;❌ No real-time knowledge&lt;br/&gt;❌ Cannot setup environments&lt;br/&gt;❌ Input/Output = text only&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;" parent="1" vertex="1">
          <mxGeometry x="60" y="600" width="260" height="110" as="geometry" />
        </mxCell>
