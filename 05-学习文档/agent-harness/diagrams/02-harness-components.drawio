<mxfile host="Electron">
  <diagram id="harness-components" name="Harness Components Detail">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="title" value="&lt;font style=&quot;font-size: 28px&quot;&gt;Harness Components Detail&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px; color: #888&quot;&gt;Everything that isn't the model&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;" parent="1" vertex="1">
          <mxGeometry x="400" y="20" width="400" height="50" as="geometry" />
        </mxCell>
        <!-- Component 1: System Prompts -->
        <mxCell id="box1" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;① System Prompts&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#666;margin-top:4px&quot;&gt;• Instructions &amp;amp; constraints&lt;br/&gt;• Role definitions&lt;br/&gt;• Behavioral guidelines&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;shadow=1;spacingTop=10;spacingLeft=10;spacingRight=10;spacingBottom=10;" parent="1" vertex="1">
          <mxGeometry x="60" y="100" width="240" height="110" as="geometry" />
