        <!-- Component 2: Tools -->
        <mxCell id="box2" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;② Tools / Skills / MCPs&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#666;margin-top:4px&quot;&gt;• Tool definitions + descriptions&lt;br/&gt;• Skills (specialized instructions)&lt;br/&gt;• MCP servers for external APIs&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;shadow=1;spacingTop=10;spacingLeft=10;spacingRight=10;spacingBottom=10;" parent="1" vertex="1">
          <mxGeometry x="320" y="100" width="260" height="110" as="geometry" />
        </mxCell>
        <!-- Component 3: Infrastructure -->
        <mxCell id="box3" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;③ Infrastructure&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#666;margin-top:4px&quot;&gt;• Filesystem (workspace)&lt;br/&gt;• Sandbox (safe execution)&lt;br/&gt;• Browser (web automation)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;shadow=1;spacingTop=10;spacingLeft=10;spacingRight=10;spacingBottom=10;" parent="1" vertex="1">
          <mxGeometry x="600" y="100" width="240" height="110" as="geometry" />
        </mxCell>
        <!-- Component 4: Orchestration -->
        <mxCell id="box4" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;④ Orchestration&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#666;margin-top:4px&quot;&gt;• Subagent spawning&lt;br/&gt;• Task handoffs&lt;br/&gt;• Model routing (smart selection)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;shadow=1;spacingTop=10;spacingLeft=10;spacingRight=10;spacingBottom=10;" parent="1" vertex="1">
          <mxGeometry x="860" y="100" width="240" height="110" as="geometry" />
        </mxCell>
        <!-- Component 5: Hooks -->
        <mxCell id="box5" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;⑤ Hooks / Middleware&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#666;margin-top:4px&quot;&gt;• Context compaction&lt;br/&gt;• Continuation management&lt;br/&gt;• Lint checks / validation&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;shadow=1;spacingTop=10;spacingLeft=10;spacingRight=10;spacingBottom=10;" parent="1" vertex="1">
