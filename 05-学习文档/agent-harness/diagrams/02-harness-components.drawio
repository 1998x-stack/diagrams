        <mxCell id="arrow-mh" value="&lt;div style=&quot;font-size:14px;font-weight:bold;color:#82b366&quot;&gt;+ HARNESS&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="350" y="640" width="100" height="30" as="geometry" />
        </mxCell>
        <!-- Agent capabilities -->
        <mxCell id="agent-cap-title" value="&lt;font style=&quot;font-size:16px;font-weight:bold;color:#82b366&quot;&gt;Agent (Model + Harness)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="680" y="560" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="agent-cap" value="&lt;div style=&quot;font-size:12px&quot;&gt;✅ Persistent state via filesystem&lt;br/&gt;✅ Code execution via bash tool&lt;br/&gt;✅ Real-time knowledge via search&lt;br/&gt;✅ Environment setup in sandbox&lt;br/&gt;✅ Multimodal I/O support&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=6;" parent="1" vertex="1">
