<mxfile host="Electron">
  <diagram id="context-rot" name="Context Rot & Solutions">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" background="#f5f5f5" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Battling Context Rot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #888&quot;&gt;How harnesses manage the context window problem&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="50" as="geometry" />
        </mxCell>
        <!-- What is Context Rot -->
        <mxCell id="what-title" value="&lt;b&gt;What is Context Rot?&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="context-rot-def" value="&lt;font style=&quot;font-size:13px&quot;&gt;As the context window fills up, models become worse at&lt;br&gt;reasoning and completing tasks.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#888&quot;&gt;• Longer context → weaker reasoning&lt;br&gt;• Tool outputs pollute the window&lt;br&gt;• Too many tools loaded at start&lt;br&gt;• History accumulates but quality drops&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;arcSize=8;shadow=1;spacingTop=10;spacingLeft=10;spacingRight=10;spacingBottom=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="300" height="140" as="geometry" />
        </mxCell>
        <!-- Visual representation of context window filling -->
        <mxCell id="cw-title" value="&lt;b&gt;Context Window Filling Over Time&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="300" height="30" as="geometry" />
        </mxCell>
        <!-- Context window visualization -->
        <mxCell id="cw1" value="&lt;font style=&quot;font-size:11px&quot;&gt;User message&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="400" y="140" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cw2" value="&lt;font style=&quot;font-size:11px&quot;&gt;Tool output (large)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="400" y="175" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cw3" value="&lt;font style=&quot;font-size:11px&quot;&gt;Tool definitions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="400" y="210" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cw4" value="&lt;font style=&quot;font-size:11px&quot;&gt;History...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="400" y="245" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cw5" value="&lt;font style=&quot;font-size:11px&quot;&gt;History...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="400" y="280" width="200" height="30" as="geometry" />
        </mxCell>
        <!-- Window limit line -->
        <mxCell id="limit-line" value="&lt;font style=&quot;font-size:10px;color:#b85450;font-weight:bold&quot;&gt;⚠ CONTEXT LIMIT&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="610" y="210" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="limit-bar" value="" style="line;strokeWidth=2;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="300" width="200" height="10" as="geometry" />
        </mxCell>
        <!-- Three Solutions -->
        <mxCell id="sol-title" value="&lt;b&gt;Three Solutions&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="100" y="340" width="150" height="30" as="geometry" />
        </mxCell>
        <!-- Solution 1: Compaction -->
        <mxCell id="sol1" value="&lt;b style=&quot;font-size:14px&quot;&gt;① Compaction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666&quot;&gt;&lt;b&gt;What to do when the context window is close to filling up&lt;/b&gt;&lt;br&gt;• Summarize earlier conversation&lt;br&gt;• Drop redundant information&lt;br&gt;• Keep only critical context&lt;br&gt;• Preserve key decisions &amp; facts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;arcSize=8;shadow=1;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="320" height="140" as="geometry" />
        </mxCell>
        <!-- Solution 2: Tool Call Offloading -->
        <mxCell id="sol2" value="&lt;b style=&quot;font-size:14px&quot;&gt;② Tool Call Offloading&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666&quot;&gt;&lt;b&gt;Reduce the impact of large tool outputs&lt;/b&gt;&lt;br&gt;• Store large outputs externally&lt;br&gt;• Reference by path/URL instead&lt;br&gt;• Summarize tool results&lt;br&gt;• Only keep relevant excerpts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=8;shadow=1;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="390" width="320" height="140" as="geometry" />
        </mxCell>
        <!-- Solution 3: Skills -->
        <mxCell id="sol3" value="&lt;b style=&quot;font-size:14px&quot;&gt;③ Skills&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666&quot;&gt;&lt;b&gt;Address too many tools or MCP servers loaded at start&lt;/b&gt;&lt;br&gt;• Load tools on-demand, not upfront&lt;br&gt;• Contextual tool activation&lt;br&gt;• Reduce startup context pollution&lt;br&gt;• Match tools to current task&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;shadow=1;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="390" width="320" height="140" as="geometry" />
        </mxCell>
        <!-- Arrows between solutions -->
        <mxCell id="arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999;strokeWidth=1;dashed=1;endArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="460" as="sourcePoint" />
            <mxPoint x="400" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arr2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999;strokeWidth=1;dashed=1;endArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="720" y="460" as="sourcePoint" />
            <mxPoint x="740" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Arrow down to result -->
        <mxCell id="arr-down" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="660" y="530" as="sourcePoint" />
            <mxPoint x="660" y="580" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Result -->
        <mxCell id="result" value="&lt;b style=&quot;font-size:15px&quot;&gt;✅ Result: Efficient Context Management&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#666&quot;&gt;The agent maintains high reasoning quality across long conversations by intelligently managing its context window.&lt;br&gt;Compaction + Offloading + Skills = &lt;b&gt;sustained performance&lt;/b&gt; instead of gradual degradation.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;shadow=1;spacingTop=10;spacingLeft=10;spacingRight=10;spacingBottom=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="600" width="800" height="80" as="geometry" />
        </mxCell>
        <!-- Footer -->
        <mxCell id="footer" value="Source: LangChain Blog — The Anatomy of an Agent Harness (Vivek Trivedy, March 2026)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="720" width="500" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
