<mxfile host="Electron">
  <diagram id="agent-arch" name="Agent Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" background="#f5f5f5" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Agent Architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Agent = Model + Harness&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="480" y="20" width="240" height="50" as="geometry" />
        </mxCell>
        <!-- Main equation: Model + Harness = Agent -->
        <mxCell id="model" value="🧠 Model&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #666&quot;&gt;Intelligence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="plus" value="+" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="275" y="140" width="30" height="40" as="geometry" />
        </mxCell>
        <mxCell id="harness" value="⚙️ Harness&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #666&quot;&gt;Work Engine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="equals" value="=" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="140" width="30" height="40" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="🤖 Agent&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #666&quot;&gt;Autonomous Execution&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="120" width="200" height="80" as="geometry" />
        </mxCell>
        <!-- Harness Components -->
        <mxCell id="comp-title" value="&lt;b&gt;Harness Components&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="480" y="250" width="200" height="30" as="geometry" />
        </mxCell>
        <!-- Arrow from Harness to Components -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="200" as="sourcePoint" />
            <mxPoint x="580" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Component boxes -->
        <mxCell id="c1" value="1️⃣ System Prompts&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #888&quot;&gt;Instructions &amp; Constraints&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="2️⃣ Tools / Skills / MCPs&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #888&quot;&gt;Capabilities + Descriptions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="260" y="300" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="3️⃣ Infrastructure&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #888&quot;&gt;Filesystem, Sandbox, Browser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="300" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="4️⃣ Orchestration&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #888&quot;&gt;Subagents, Handoffs, Routing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="300" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="5️⃣ Hooks / Middleware&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #888&quot;&gt;Compaction, Continuation, Lint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="920" y="300" width="200" height="60" as="geometry" />
        </mxCell>
        <!-- Arrows from Harness to components -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="280" as="sourcePoint" />
            <mxPoint x="140" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="280" as="sourcePoint" />
            <mxPoint x="360" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="280" as="sourcePoint" />
            <mxPoint x="580" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="280" as="sourcePoint" />
            <mxPoint x="800" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="280" as="sourcePoint" />
            <mxPoint x="1020" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Model Limitations section -->
        <mxCell id="limit-title" value="&lt;b&gt;Model Limitations (Without Harness)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="430" y="400" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="❌ No durable state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="100" y="450" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="❌ Cannot execute code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="320" y="450" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="❌ No real-time knowledge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="540" y="450" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="❌ No environment setup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="760" y="450" width="200" height="40" as="geometry" />
        </mxCell>
        <!-- Arrow down to solutions -->
        <mxCell id="arrow-down" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="500" as="sourcePoint" />
            <mxPoint x="580" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Harness Solutions -->
        <mxCell id="sol-title" value="&lt;b&gt;Harness Solutions&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="460" y="550" width="240" height="30" as="geometry" />
