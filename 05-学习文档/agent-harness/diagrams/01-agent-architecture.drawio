        <mxCell id="s3" value="✅ Web search for knowledge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="540" y="600" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="✅ Sandbox for env setup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="760" y="600" width="200" height="40" as="geometry" />
        </mxCell>
        <!-- Quote -->
        <mxCell id="quote" value="&quot;If you're not the model, you're the harness.&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#999999;fontSize=14;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="660" width="300" height="30" as="geometry" />
        </mxCell>
        <!-- Footer -->
        <mxCell id="footer" value="Source: LangChain Blog — The Anatomy of an Agent Harness (Vivek Trivedy, March 2026)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="680" width="500" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
