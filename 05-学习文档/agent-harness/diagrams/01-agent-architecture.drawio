        <mxCell id="s1" value="✅ Filesystem + Git for state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
