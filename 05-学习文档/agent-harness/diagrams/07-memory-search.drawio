<mxfile host="Electron">
  <diagram id="memory-search" name="Memory & Search Flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" background="#f5f5f5" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Memory &amp; Search for Continual Learning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #888&quot;&gt;How agents store knowledge across sessions&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="50" as="geometry" />
        </mxCell>
        <!-- Agent Start -->
        <mxCell id="agent-start" value="&lt;b&gt;Agent Starts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;New session begins&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="180" height="70" as="geometry" />
        </mxCell>
        <!-- Arrow to inject -->
        <mxCell id="arrow1" value="&lt;font style=&quot;font-size:11px&quot;&gt;load&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="135" as="sourcePoint" />
            <mxPoint x="340" y="135" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Context Injection -->
        <mxCell id="inject" value="&lt;b&gt;Context Injection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;AGENTS.md injected into context&lt;br&gt;System prompts loaded&lt;br&gt;Skills activated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="200" height="70" as="geometry" />
        </mxCell>
        <!-- Arrow to work -->
        <mxCell id="arrow2" value="&lt;font style=&quot;font-size:11px&quot;&gt;execute&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="540" y="135" as="sourcePoint" />
            <mxPoint x="600" y="135" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Agent Works -->
        <mxCell id="work" value="&lt;b&gt;Agent Works&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Reads files, executes code&lt;br&gt;Makes decisions, produces output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="200" height="70" as="geometry" />
        </mxCell>
        <!-- Arrow to learn -->
        <mxCell id="arrow3" value="&lt;font style=&quot;font-size:11px&quot;&gt;discovers&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="800" y="135" as="sourcePoint" />
            <mxPoint x="860" y="135" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Learns -->
        <mxCell id="learn" value="&lt;b&gt;Learns &amp; Updates&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Edits AGENTS.md with&lt;br&gt;new knowledge, lessons&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="100" width="200" height="70" as="geometry" />
        </mxCell>
        <!-- Arrow back (loop) -->
        <mxCell id="arrow-loop" value="&lt;font style=&quot;font-size:11px&quot;&gt;next session uses updated memory&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="960" y="170" as="sourcePoint" />
            <mxPoint x="960" y="200" as="targetPoint" />
            <mxPoint x="190" y="200" as="targetPoint" />
            <mxPoint x="190" y="170" as="targetPoint" />
            <Array as="points">
              <mxPoint x="960" y="220" />
              <mxPoint x="190" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- Loop label -->
        <mxCell id="loop-label" value="&lt;b&gt;🔄 Continual Learning Loop&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="450" y="200" width="200" height="30" as="geometry" />
        </mxCell>
        <!-- AGENTS.md detail -->
        <mxCell id="agents-title" value="&lt;b&gt;AGENTS.md — The Memory Standard&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="500" y="280" width="300" height="30" as="geometry" />
        </mxCell>
        <!-- AGENTS.md content -->
        <mxCell id="agents-content" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;What goes into AGENTS.md:&lt;/b&gt;&lt;br&gt;• Project structure &amp; conventions&lt;br&gt;• Tool configurations &amp; preferences&lt;br&gt;• Lessons learned from past sessions&lt;br&gt;• Important decisions &amp; rationale&lt;br&gt;• User preferences &amp; behavioral guidelines&lt;br&gt;• Common pitfalls to avoid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffacd;strokeColor=#d6b656;strokeWidth=2;arcSize=8;shadow=1;spacingTop=10;spacingLeft=10;spacingRight=10;spacingBottom=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="330" width="400" height="150" as="geometry" />
        </mxCell>
        <!-- Memory lifecycle -->
        <mxCell id="lifecycle-title" value="&lt;b&gt;Memory Lifecycle&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="700" y="280" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lc1" value="&lt;b&gt;1. Write&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Agent writes knowledge&lt;br&gt;to memory files&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="650" y="330" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lc2" value="&lt;b&gt;2. Persist&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Files survive session&lt;br&gt;restarts (durable)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="650" y="410" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lc3" value="&lt;b&gt;3. Load&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Next session loads&lt;br&gt;memory into context&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="870" y="330" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lc4" value="&lt;b&gt;4. Apply&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Agent uses prior&lt;br&gt;knowledge in new work&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="870" y="410" width="200" height="70" as="geometry" />
        </mxCell>
        <!-- Arrows in lifecycle -->
        <mxCell id="lc-arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="400" as="sourcePoint" />
            <mxPoint x="750" y="410" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lc-arr2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="850" y="365" as="sourcePoint" />
            <mxPoint x="870" y="365" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lc-arr3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="970" y="400" as="sourcePoint" />
            <mxPoint x="970" y="410" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Key insight -->
        <mxCell id="insight" value="&lt;b style=&quot;font-size:14px&quot;&gt;💡 Key Insight&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#666&quot;&gt;The filesystem is the core memory primitive. As agents edit memory files, the harness loads updated content into context on each session start.&lt;br&gt;This creates &lt;b&gt;continual learning&lt;/b&gt; — knowledge persists across sessions and compounds over time.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffacd;strokeColor=#d6b656;strokeWidth=2;arcSize=8;shadow=1;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="520" width="800" height="80" as="geometry" />
        </mxCell>
        <!-- Footer -->
        <mxCell id="footer" value="Source: LangChain Blog — The Anatomy of an Agent Harness (Vivek Trivedy, March 2026)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="630" width="500" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
